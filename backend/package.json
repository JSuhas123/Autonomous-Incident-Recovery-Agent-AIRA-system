{
  "name": "autonomous-backend-incident-recovery-agent-backend",
  "version": "1.0.0",
  "description": "Backend for autonomous incident detection and recovery simulation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:phase1": "jest tests/integration/phase1-integration.test.js --detectOpenHandles --forceExit",
    "test:phase2": "jest tests/integration/phase2-integration.test.js --detectOpenHandles --forceExit",
    "test:phase3": "jest tests/integration/phase3-integration.test.js --detectOpenHandles --forceExit",
    "test:load": "jest production-load.test.js --testTimeout=600000 --detectOpenHandles --forceExit",
    "test:load:quick": "jest production-load.test.js -t 'sustained load' --testTimeout=120000 --detectOpenHandles --forceExit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "isomorphic-dompurify": "^2.30.0",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.6.2",
    "prom-client": "^15.1.0",
    "redis": "^4.6.12",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.3"
  }
}
