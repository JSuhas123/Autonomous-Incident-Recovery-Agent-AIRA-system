{
  "name": "autonomous-backend-incident-recovery-agent-backend",
  "version": "1.0.0",
  "description": "Backend for autonomous incident detection and recovery simulation",
  "main": "server.js",
  "bin": {
    "aira": "./cli/aira.js"
  },
  "scripts": {
    "start": "npm run deps:up && node server.js",
    "start:server": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed-dev-data.js",
    "simulate": "node run-simulation.js",
    "simulate:clean": "rm -rf simulation/results/* && npm run simulate",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:load": "jest production-load.test.js --testTimeout=600000 --detectOpenHandles --forceExit",
    "test:load:quick": "jest production-load.test.js -t 'sustained load' --testTimeout=120000 --detectOpenHandles --forceExit",
    "test:observability": "jest tests/integration/observability-validation.test.js --detectOpenHandles --forceExit",
    "test:observability:logging": "jest tests/integration/observability-validation.test.js -t 'Structured Logging' --detectOpenHandles --forceExit",
    "test:observability:metrics": "jest tests/integration/observability-validation.test.js -t 'Prometheus Metrics' --detectOpenHandles --forceExit",
    "test:observability:audit": "jest tests/integration/observability-validation.test.js -t 'Audit Trail' --detectOpenHandles --forceExit",
    "test:observability:e2e": "jest tests/integration/observability-validation.test.js -t 'End-to-End Tracing' --detectOpenHandles --forceExit",
    "test:observability:alerts": "jest tests/integration/observability-validation.test.js -t 'Alert Validation' --detectOpenHandles --forceExit",
    "test:kubernetes-phase3-e2e": "jest tests/integration/kubernetesPhase3.e2e.test.js --runInBand --forceExit",
    "test:kubernetes-phase3-playbooks": "jest tests/unit/kubernetesPhase3PlaybookMapping.test.js --runInBand --forceExit",
    "test:kubernetes-phase3-diagnosis": "jest tests/unit/kubernetesPhase3Diagnosis.test.js --runInBand --forceExit",
    "test:kubernetes-phase2": "jest tests/unit/kubernetesPhase2.test.js --runInBand --forceExit",
    "test:architecture": "jest tests/unit/v2RuntimeArchitecture.test.js --runInBand --forceExit",
    "test:migration-control": "jest tests/unit/migrationControlPlane.test.js --runInBand",
    "test:persistence": "jest persistence --runInBand",
    "check:observability": "node scripts/check-observability-health.js --verbose",
    "validate:observability": "node scripts/validate-observability-pipeline.js --suite=all",
    "generate:samples": "node scripts/generate-observability-samples.js --count=20 --tenant=demo-tenant",
    "migrate:monitors:environments": "node scripts/migrate-monitors-to-environments.js",
    "migrate:webhooks:environments": "node scripts/migrate-webhooks-to-environments.js",
    "migrate:kubernetes:environments": "node scripts/migrate-kubernetes-to-environments.js",
    "migrate:recovery:environments": "node scripts/migrate-recovery-to-environments.js",
    "migrate:integrations:environments": "node scripts/migrate-integrations-to-environments.js",
    "migrate:services:environments": "node scripts/migrate-services-to-environments.js",
    "migrate:incidents:environments": "node scripts/migrate-incidents-to-environments.js",
    "db:postgres:check": "node scripts/check-postgres.js",
    "db:postgres:migrate": "node scripts/postgres-migrate.js",
    "bootstrap:organizations": "node scripts/bootstrap-organizations.js",
    "postgres:backfill": "node scripts/postgres-backfill.js",
    "postgres:backfill:dry-run": "node scripts/postgres-backfill.js --dry-run",
    "postgres:verify": "node scripts/postgres-verify.js",
    "deps:up": "docker compose -f ../docker-compose.yml up -d --wait postgres redis rabbitmq qdrant",
    "deps:down": "docker compose -f ../docker-compose.yml stop postgres redis rabbitmq qdrant",
    "deps:status": "docker compose -f ../docker-compose.yml ps postgres redis rabbitmq qdrant",
    "deps:logs": "docker compose -f ../docker-compose.yml logs --tail=30 postgres redis rabbitmq qdrant"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1109.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1109.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1109.0",
    "@azure/arm-resources": "^7.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-query": "^1.3.3",
    "@google-cloud/logging": "^11.4.0",
    "@google-cloud/monitoring": "^5.4.0",
    "@kubernetes/client-node": "^0.21.0",
    "@node-rs/argon2": "^2.0.2",
    "@qdrant/js-client-rest": "^1.19.0",
    "amqplib": "^0.10.4",
    "axios": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "joi": "^17.11.0",
    "js-yaml": "^4.1.0",
    "mongoose": "^8.6.2",
    "pg": "^8.22.0",
    "prom-client": "^15.1.0",
    "redis": "^4.6.12",
    "stripe": "^20.4.0",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.4",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "form-data": ">=4.0.1",
    "tough-cookie": ">=4.1.3",
    "qs": ">=6.14.1"
  }
}
