# =========== SERVICE PORTS ===========
PORT=5000

# =========== DATABASE (MONGODB) ===========
MONGODB_URI=mongodb://127.0.0.1:27017/decision_engine
DISABLE_MEMORY_DB=false

# =========== MESSAGE QUEUE (RABBITMQ) ===========
RABBITMQ_URL=amqp://localhost

# =========== DISTRIBUTED STATE (REDIS) ===========
REDIS_URL=redis://localhost:6379

# =========== DISTRIBUTED LOCKS ===========
ALLOW_IN_MEMORY_LOCKS=true

# =========== OPENAI / AI FEATURES ===========
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# =========== AUDIT & SECURITY ===========
AUDIT_SECRET=audit-secret-change-me

# =========== INTEGRATIONS ===========
PAGERDUTY_TOKEN=

# =========== ENVIRONMENT ===========
NODE_ENV=development

# =========== LOGGING ===========
LOG_LEVEL=info

# =========== METRICS ===========
METRICS_ENABLED=true

# =========== TENANT CONFIGURATION ===========
DEFAULT_TENANT=default

# =========== FEATURE FLAGS ===========
SAFE_MODE=false
DETAILED_AUDIT_LOGGING=false

