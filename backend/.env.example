# ============================================================
# AIRA LOCAL DEVELOPMENT CONFIGURATION
# ============================================================

NODE_ENV=development
PORT=5000

# ============================================================
# PHASE 13 — AUTHORITATIVE PERSISTENCE
# ============================================================

PERSISTENCE_PROVIDER=postgres
POSTGRES_ENABLED=true
MIGRATION_MODE=disabled

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=aira
POSTGRES_USER=aira
POSTGRES_PASSWORD=aira_local_password

POSTGRES_APPLICATION_NAME=aira-backend

POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=20

POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_QUERY_TIMEOUT_MS=30000

POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_TRANSACTION_ISOLATION=READ COMMITTED
POSTGRES_MIGRATION_LOCK_ID=1302001

# MongoDB is NOT part of normal runtime.
# Only configure this temporarily for migration/backfill tooling.
# MONGODB_URI=

# ============================================================
# REDIS
# ============================================================

REDIS_URL=redis://127.0.0.1:6379
ALLOW_IN_MEMORY_LOCKS=true

# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# AI
# ============================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# SECURITY
# ============================================================

AUDIT_SECRET=aira-local-development-audit-secret-change-me
JWT_SECRET=aira-local-development-jwt-secret-change-me
IP_HASH_SALT=aira-local-development-ip-hash-salt

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
SESSION_REMEMBER_ME_TIMEOUT_MS=2592000000
SESSION_ACTIVITY_THROTTLE_MS=60000

# ============================================================
# OBSERVABILITY
# ============================================================

LOG_LEVEL=info
METRICS_ENABLED=true
DETAILED_AUDIT_LOGGING=false

# ============================================================
# SAFETY
# ============================================================

SAFE_MODE=false
DISABLE_MEMORY_DB=true

# ============================================================
# MIGRATION TOOLING — DISABLED IN NORMAL RUNTIME
# ============================================================

MIGRATION_BATCH_SIZE=250
MIGRATION_SHADOW_READS_ENABLED=false
MIGRATION_FAIL_ON_MISMATCH=true
MIGRATION_ROLLBACK_WINDOW_HOURS=72
MIGRATION_FAILURE_POLICY=fail-fast
MIGRATION_DRY_RUN=false
MIGRATION_BATCH_DELAY_MS=0
MIGRATION_LOG_EVERY_BATCH=true
