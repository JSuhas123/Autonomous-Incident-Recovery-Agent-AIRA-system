# ============================================
# AIRA Configuration - Environment Template
# ============================================
# 
# IMPORTANT: Copy this file to .env and customize for your environment
# LOCAL DEVELOPMENT: Use defaults below (they work with docker-compose)
# PRODUCTION: Replace with actual secrets and production values
#
# NB: .env file is in .gitignore, so your secrets won't be committed
#

# =========== SERVICE PORTS ===========
PORT=5000

# =========== ENVIRONMENT ===========
# Values: development | test | production
NODE_ENV=development

# =========== CORS ===========
# Comma-separated list of allowed browser origins (no trailing slashes, no quotes, no brackets).
# In development the defaults below are used automatically when this variable is unset.
# In Railway production, set this to exactly: https://autonomous-incident-recovery-agent-ten.vercel.app
# (Add additional origins with commas, e.g. http://localhost:5173,https://your-frontend.vercel.app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://autonomous-incident-recovery-agent-ten.vercel.app

# =========== DATABASE (MONGODB) ===========
# Local development: mongodb://127.0.0.1:27017/decision_engine
# Docker Compose: mongodb://mongodb:27017/decision_engine  
# Atlas Cloud: mongodb+srv://user:password@cluster.mongodb.net/decision_engine
MONGODB_URI=mongodb://127.0.0.1:27017/decision_engine

# Disable in-memory fallback - set to "true" in production
DISABLE_MEMORY_DB=false

# =========== MESSAGE QUEUE (RABBITMQ) ===========
# Local development: amqp://localhost
# Docker Compose: amqp://rabbitmq:5672
# Production: amqp://user:password@host:5672
RABBITMQ_URL=amqp://localhost

# =========== DISTRIBUTED STATE (REDIS) ===========
# Local development: redis://localhost:6379
# Docker Compose: redis://redis:6379  
# Production: redis://user:password@host:6379
REDIS_URL=redis://localhost:6379

# Allow in-memory locks fallback in development (set to false in production)
ALLOW_IN_MEMORY_LOCKS=true

# =========== OPENAI / AI FEATURES ===========
# OpenAI API key for analysis agent
# Get from: https://platform.openai.com/api-keys
# Leave empty to skip AI-based analysis
OPENAI_API_KEY=

# Model: gpt-4o-mini (cost effective) or gpt-4o (more accurate)
OPENAI_MODEL=gpt-4o-mini

# =========== AUDIT & SECURITY ===========
# Secret for audit trail signing (change in production!)
AUDIT_SECRET=audit-secret-change-in-production

# =========== INTEGRATIONS ===========
# PagerDuty API token (optional, for escalations)
PAGERDUTY_TOKEN=

# =========== LOGGING ===========
# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# =========== METRICS ===========
METRICS_ENABLED=true

# =========== TENANT CONFIGURATION ===========
DEFAULT_TENANT=default

# =========== FEATURE FLAGS ===========
# SAFE_MODE: When true, block all action execution (for manual review)
SAFE_MODE=false

# =========== IDENTITY / HUMAN AUTHENTICATION ===========
# Argon2id hashing parameters — increase memory/time for stronger security in production
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Session idle and absolute timeout (milliseconds)
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_TIMEOUT_MS=28800000
SESSION_REMEMBER_ME_TIMEOUT_MS=2592000000
SESSION_ACTIVITY_THROTTLE_MS=60000

# Salt mixed into IP address hashes (any random string; change per environment)
IP_HASH_SALT=change-me-in-production

# JWT secret used by devAuthRoutes — replace with a production auth provider
JWT_SECRET=dev-jwt-secret-change-in-production-32chars

# DETAILED_AUDIT_LOGGING: Extra verbose logging for debugging
DETAILED_AUDIT_LOGGING=false

