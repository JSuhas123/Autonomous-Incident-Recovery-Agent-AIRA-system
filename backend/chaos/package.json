{
  "name": "@incident-response/chaos-testing-harness",
  "version": "1.0.0",
  "description": "Comprehensive chaos testing harness for the Lean Incident Response Decision Engine",
  "main": "run-chaos-tests.js",
  "bin": {
    "chaos-tests": "run-chaos-tests.js",
    "chaos-quick-start": "quick-start.js"
  },
  "scripts": {
    "test": "node run-chaos-tests.js",
    "test:quick": "node quick-start.js",
    "test:validate": "node quick-start.js --baseUrl http://localhost:5000",
    "test:production": "node run-chaos-tests.js --baseUrl http://prod-api:5000",
    "test:staging": "node run-chaos-tests.js --baseUrl http://staging-api:5000"
  },
  "keywords": [
    "chaos-testing",
    "incident-response",
    "decision-engine",
    "system-validation",
    "failure-scenarios",
    "safety-verification",
    "cascade-prevention"
  ],
  "author": "SRE Team - Incident Response",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "internal-repo"
  },
  "bugs": {
    "url": "internal-repo/issues"
  },
  "files": [
    "ChaosTestFramework.js",
    "SafetyGatesValidator.js",
    "ChaosScenarios.js",
    "ChaosTestReporter.js",
    "ChaosTestUtils.js",
    "run-chaos-tests.js",
    "quick-start.js",
    "README.md",
    "CHAOS-TESTING-GUIDE.md",
    "IMPLEMENTATION-SUMMARY.md"
  ]
}
